# Copy to .env and fill in. Never commit .env.

# --- Required ---
# Neon PostgreSQL connection string (Neon console -> Branches -> Roles & Databases)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Long random string used to sign session JWTs (e.g. `openssl rand -hex 32`)
JWT_SECRET="replace-with-a-long-random-secret"

# --- Admin portal (/admin/login) ---
SUPER_ADMIN_EMAIL="admin@example.com"
# bcrypt hash of the admin password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# The hash contains "$" which Next's env loader expands as variables. Escape every "$" as "\$":
#   SUPER_ADMIN_PASSWORD_HASH="\$2b\$10\$abc..."
SUPER_ADMIN_PASSWORD_HASH=""

# Optional: separate key for signing certificates (falls back to JWT_SECRET)
CERTIFICATE_SIGNING_KEY=""

# --- Email (password reset + certificate delivery). Optional in dev; emails are skipped if unset. ---
APP_URL="http://localhost:3000"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="no-reply@example.com"

# --- Rate limiting (optional). Falls back to in-memory limiting if unset. ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Secret for scheduled jobs (e.g. GET /api/cron/purge-documents with "Authorization: Bearer <secret>")
CRON_SECRET=""
# Optional: separate pepper for hashing government ID numbers (falls back to JWT_SECRET)
ID_HASH_PEPPER=""

# --- Billing (Safepay hosted checkout; https://getsafepay.com) ---
# "sandbox" or "production". Base URL must match the environment.
SAFEPAY_ENV="sandbox"
SAFEPAY_BASE_URL="https://sandbox.api.getsafepay.com"
# Dashboard -> Developers -> API keys
SAFEPAY_PUBLIC_KEY=""
SAFEPAY_SECRET_KEY=""
# Dashboard -> Developers -> Webhooks -> endpoint <APP_URL>/api/safepay/webhook (shared secret)
SAFEPAY_WEBHOOK_SECRET=""
# Optional price overrides in US cents (defaults: 500 / 1000 / 2000) and free posts per verified client (default 2)
PLAN_PRICE_STARTER_CENTS=""
PLAN_PRICE_GROWTH_CENTS=""
PLAN_PRICE_PRO_CENTS=""
FREE_POSTS=""
