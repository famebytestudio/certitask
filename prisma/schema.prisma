generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * ───────────────────────── Enums ─────────────────────────
 */

enum Role {
  CLIENT // posts projects (an organization or an individual)
  TALENT // does the work and earns certificates
}

enum ClientType {
  INDIVIDUAL
  ORGANIZATION
}

enum VerificationStatus {
  UNVERIFIED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum VerificationKind {
  IDENTITY // talent or individual client: government ID
  ORGANIZATION // organization client: registration proof + authorized person ID
}

enum DocumentType {
  ID_FRONT
  ID_BACK
  SELFIE_WITH_ID
  ORG_REGISTRATION
  AUTHORIZED_PERSON_ID
  OTHER
}

enum ProjectCategory {
  SOFTWARE_DEVELOPMENT
  WEB_AND_MOBILE
  DATA_AND_AI
  DESIGN_AND_UX
  MARKETING_AND_CONTENT
  RESEARCH_AND_WRITING
  BUSINESS_AND_OPERATIONS
  OTHER
}

enum ProjectStatus {
  DRAFT
  PENDING_PAYMENT
  ACTIVE
  PAUSED
  CLOSED
  COMPLETED
}

enum TeamMemberRole {
  LEAD
  MEMBER
}

enum TeamMemberStatus {
  INVITED
  ACCEPTED
  DECLINED
  REMOVED
  EXPIRED
  LEFT
}

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  SELECTED
  REJECTED
  WITHDRAWN
}

enum SubmissionStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum CertificateStatus {
  VERIFIED
  REVOKED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum PlanTier {
  STARTER
  GROWTH
  PRO
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
}

/**
 * ───────────────────────── Users ─────────────────────────
 */

model User {
  id              String      @id @default(uuid())
  email           String      @unique
  emailVerifiedAt DateTime?
  password        String
  role            Role
  clientType      ClientType? // required when role = CLIENT
  name            String // display name (person or organization)
  legalName       String? // name as it appears on the verified ID / registration; printed on certificates
  suspendedAt     DateTime? // set by admin; blocks login

  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?

  // Client billing (Phase 4)
  freePostsUsed Int @default(0) // lifetime free published projects (2 for verified clients)

  // Common profile
  avatarUrl String?
  bio       String?
  website   String?
  phone     String?
  location  String?

  // Organization profile (clientType = ORGANIZATION)
  industry           String?
  organizationSize   String? // "1-50", "51-200", ...
  foundedYear        Int?
  registrationNumber String? // SECP / NTN / business registration
  linkedinUrl        String?

  // Talent profile
  dateOfBirth     DateTime?
  gender          String?
  universityName  String?
  degreeProgram   String?
  currentSemester String?
  gpa             Float?
  skills          String[]  @default([])
  portfolioUrl    String?
  resumeUrl       String?

  // Government ID (never stored in plain text)
  idType       String? // CNIC | PASSPORT | NATIONAL_ID
  idNumberHash String? @unique
  idLast4      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectsPosted       Project[]             @relation("ClientProjects")
  teamsLed             Team[]                @relation("TeamLead")
  teamMemberships      TeamMember[]
  submissions          Submission[]          @relation("SubmittedBy")
  certificatesEarned   Certificate[]         @relation("TalentCertificates")
  certificatesIssued   Certificate[]         @relation("ClientCertificates")
  certificateHolds     CertificateHold[]
  verificationRequests VerificationRequest[]
  documents            Document[]
  payments             Payment[]
  subscriptions        Subscription[]
  notifications        Notification[]

  @@index([role])
  @@index([verificationStatus])
  @@map("users")
}

/**
 * ───────────────────────── Projects ─────────────────────────
 */

model Project {
  id             String          @id @default(uuid())
  clientId       String
  client         User            @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Cascade)
  title          String
  description    String
  category       ProjectCategory @default(OTHER)
  requiredSkills String[]        @default([])
  deliverables   String
  deadline       DateTime
  teamCap        Int             @default(1) // 1..20
  status         ProjectStatus   @default(DRAFT)
  publishedAt    DateTime?
  closedAt       DateTime?
  subscriptionId String? // period this publish was counted against (null = free post)
  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  featured       Boolean         @default(false) // Pro perk
  viewCount      Int             @default(0) // public detail page views (analytics perk)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  teams        Team[]
  applications Application[]
  submissions  Submission[]
  certificates Certificate[]
  payments     Payment[]
  holds        CertificateHold[]

  @@index([status, deadline])
  @@index([clientId])
  @@index([category])
  @@map("projects")
}

/**
 * ───────────────────────── Teams ─────────────────────────
 */

model Team {
  id             String    @id @default(uuid())
  name           String
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  leadId         String
  lead           User      @relation("TeamLead", fields: [leadId], references: [id], onDelete: Cascade)
  reminderSentAt DateTime? // deadline reminder (3 days before) already sent
  createdAt      DateTime  @default(now())

  members      TeamMember[]
  invites      TeamInvite[]
  application  Application?
  submission   Submission?
  certificates Certificate[]

  @@index([projectId])
  @@index([leadId])
  @@map("teams")
}

model TeamMember {
  id          String           @id @default(uuid())
  teamId      String
  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        TeamMemberRole   @default(MEMBER)
  status      TeamMemberStatus @default(INVITED)
  invitedById String?
  invitedAt   DateTime         @default(now())
  expiresAt   DateTime? // invitations lapse after 7 days
  respondedAt DateTime?

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

/// Invitation sent to an email address that has no CertiTask account yet.
/// Converted into a TeamMember (INVITED) when that email signs up as talent.
model TeamInvite {
  id          String    @id @default(uuid())
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email       String
  invitedById String
  token       String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?

  @@unique([teamId, email])
  @@index([email])
  @@map("team_invites")
}

/**
 * ───────────────────────── Applications ─────────────────────────
 */

model Application {
  id         String            @id @default(uuid())
  projectId  String
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamId     String            @unique
  team       Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  pitch      String
  status     ApplicationStatus @default(PENDING)
  reviewedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([projectId, status])
  @@map("applications")
}

/**
 * ───────────────────────── Submissions ─────────────────────────
 */

model Submission {
  id            String           @id @default(uuid())
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamId        String           @unique
  team          Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  submittedById String
  submittedBy   User             @relation("SubmittedBy", fields: [submittedById], references: [id], onDelete: Cascade)
  submissionUrl String
  notes         String?
  feedback      String?
  status        SubmissionStatus @default(SUBMITTED)
  reviewedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([projectId, status])
  @@map("submissions")
}

/**
 * ───────────────────────── Certificates ─────────────────────────
 */

model Certificate {
  id              String            @id @default(uuid())
  certId          String            @unique // public, printed on the certificate: CERT-XXXX-...
  talentId        String
  talent          User              @relation("TalentCertificates", fields: [talentId], references: [id], onDelete: Restrict)
  clientId        String
  client          User              @relation("ClientCertificates", fields: [clientId], references: [id], onDelete: Restrict)
  projectId       String
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  teamId          String?
  team            Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  // Snapshots taken at issue time so the certificate never changes if the profiles do
  recipientName   String
  recipientEmail  String
  issuerName      String
  issuerType      ClientType
  title           String
  skills          String[]          @default([])
  issuedAt        DateTime          @default(now())
  signature       String // HMAC-SHA256 over the immutable fields; tamper evidence
  status          CertificateStatus @default(VERIFIED)
  statusReason    String?
  statusChangedAt DateTime?
  createdAt       DateTime          @default(now())

  @@unique([projectId, talentId])
  @@index([talentId])
  @@index([clientId])
  @@map("certificates")
}

/// A certificate that was approved but is waiting for the recipient's identity
/// to be VERIFIED. Issued automatically when verification is approved.
model CertificateHold {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  talentId     String
  talent       User     @relation(fields: [talentId], references: [id], onDelete: Cascade)
  teamId       String?
  submissionId String?
  approvedById String
  createdAt    DateTime @default(now())

  @@unique([projectId, talentId])
  @@index([talentId])
  @@map("certificate_holds")
}

/**
 * ───────────────────────── Verification ─────────────────────────
 */

model VerificationRequest {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            VerificationKind
  status          VerificationStatus @default(PENDING_REVIEW)
  formData        Json? // submitted fields (never the raw ID number)
  submittedAt     DateTime           @default(now())
  reviewedAt      DateTime?
  reviewedBy      String? // admin identifier
  rejectionReason String?

  documents Document[]

  @@index([status, submittedAt])
  @@index([userId])
  @@map("verification_requests")
}

model Document {
  id                    String               @id @default(uuid())
  userId                String
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationRequestId String?
  verificationRequest   VerificationRequest? @relation(fields: [verificationRequestId], references: [id], onDelete: SetNull)
  type                  DocumentType
  storageKey            String               @unique // object key in private storage
  mimeType              String
  sizeBytes             Int
  createdAt             DateTime             @default(now())
  deletedAt             DateTime? // purged from storage

  @@index([userId])
  @@map("documents")
}

/// Binary storage for verification documents. Kept in Postgres for now
/// (see lib/storage.ts); swap the storage backend without touching Document.
model DocumentBlob {
  key       String   @id
  data      Bytes
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@map("document_blobs")
}

/**
 * ───────────────────────── Payments ─────────────────────────
 */

/// One checkout attempt. Amounts are in the smallest unit (cents).
model Payment {
  id             String        @id @default(uuid())
  clientId       String
  client         User          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  projectId      String? // legacy per-listing payments; unused for subscriptions
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  plan           PlanTier?
  provider       String        @default("safepay")
  providerRef    String?       @unique // Safepay tracker token
  providerState  String? // last raw state seen from the provider
  amountCents    Int
  currency       String        @default("USD")
  status         PaymentStatus @default(PENDING)
  receiptNumber  String?       @unique // CT-2026-000123, assigned on success
  paidAt         DateTime?
  refundedAt     DateTime?
  refundReason   String?
  expiresAt      DateTime? // abandoned checkouts lapse
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([clientId, createdAt])
  @@index([status])
  @@map("payments")
}

/// A prepaid 30-day plan period. A client has at most one ACTIVE period at a time.
model Subscription {
  id          String             @id @default(uuid())
  clientId    String
  client      User               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plan        PlanTier
  status      SubscriptionStatus @default(PENDING_PAYMENT)
  periodStart DateTime?
  periodEnd   DateTime?
  postsUsed   Int                @default(0)
  postLimit   Int? // null = unlimited (Pro)
  cancelledAt DateTime?
  reminded5At DateTime? // expiry reminders sent
  reminded1At DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  payments Payment[]
  projects Project[]

  @@index([clientId, status])
  @@index([status, periodEnd])
  @@map("subscriptions")
}

/**
 * ───────────────────────── Audit & notifications ─────────────────────────
 */

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String? // user id, or "super-admin"
  actorRole  String // CLIENT | TALENT | ADMIN | SYSTEM
  action     String // e.g. "submission.approved", "certificate.revoked"
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

/**
 * ───────────────────────── Misc ─────────────────────────
 */

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String
  type      String   @default("contact") // contact, client_query
  priority  Boolean  @default(false) // sent by a Pro client
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

/**
 * ───────────────────────── Auth ─────────────────────────
 */

model Session {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String // user id or "super-admin" (no FK on purpose)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}
